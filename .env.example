# Bot Token (BotFather'dan oling)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Redis URL (default: localhost:6379)
REDIS_URL=redis://localhost:6379

# Channel ID (savol yuborish uchun)
CHANNEL_ID=@sud_boshqaruvchilar

# Admin IDs (vergul bilan ajratilgan)
# ADMIN_IDS=123456,789012,345678

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Database path (default: quiz_bot.db)
DB_PATH=quiz_bot.db
